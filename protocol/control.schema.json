{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniMetersMobile control message",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "token"],
      "properties": {
        "type": { "const": "authenticate" },
        "version": { "const": 1 },
        "token": { "type": "string", "minLength": 1 },
        "deviceToken": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "sampleFormat", "deviceToken"],
      "properties": {
        "type": { "const": "authenticated" },
        "version": { "const": 1 },
        "sampleFormat": { "const": "f32le" },
        "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
        "deviceToken": { "type": "string", "minLength": 1 },
        "heartbeatIntervalMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "timestampMs"],
      "properties": {
        "type": { "const": "heartbeat" },
        "version": { "const": 1 },
        "timestampMs": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code"],
      "properties": {
        "type": { "const": "error" },
        "code": { "enum": ["invalid_token", "unsupported_version", "server_error"] },
        "message": { "type": "string" }
      }
    }
  ]
}
